generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Role {
  roleid Int @id @default(autoincrement())
  rolename String @unique @db.VarChar(50)
  users User[]
}
model MemberShip {
  mid Int @id @default(autoincrement())
  mname String @unique @db.VarChar(50)
  score Int @default(10)
  users User[]
}
model User {
  uid Int @id @default(autoincrement())
  username String @unique @db.VarChar(50)
  fullname String @default("") @db.VarChar(100)
  password String @db.VarChar(255)
  email String? @unique
  phone String?
  roleid Int
  mid Int
  role Role @relation(fields: [roleid], references: [roleid])
  membership MemberShip @relation(fields: [mid], references: [mid])
  orders Order[]
}
model Product {
  pid Int @id @default(autoincrement())
  pname String @db.VarChar(100)
  price Decimal @db.Decimal(10,2)
  quantity Int
  details OrderDetail[]
}
model Order {
  oid Int @id @default(autoincrement())
  uid Int
  createat DateTime @default(now())
  discount Decimal @db.Decimal(14,2)
  discountRate Int
  subtotal Decimal @db.Decimal(14,2)
  total Decimal @db.Decimal(14,2)
  user User @relation(fields: [uid], references: [uid])
  items OrderDetail[]
  shipment Shipment?
}
model OrderDetail {
  oid Int
  pid Int
  qty Int
  unit_price Decimal @db.Decimal(10,2)
  order Order @relation(fields: [oid], references: [oid])
  product Product @relation(fields: [pid], references: [pid])
  @@id([oid,pid])
}
model Shipment {
  shipid Int @id @default(autoincrement())
  oid Int @unique
  status String @default("PENDING") @db.VarChar(50)
  order Order @relation(fields: [oid], references: [oid])
}
